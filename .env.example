# Postgres connection string (Vercel: Storage -> Marketplace -> Neon injects this)
DATABASE_URL=

# Random secret used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required on Vercel; optional locally (falls back to a file on disk).
SESSION_SECRET=

# Vercel Blob token used for admin-uploaded photos (Vercel: Storage -> Create
# Database -> Blob -> connect to this project, which injects this automatically;
# run `vercel env pull` or copy the value manually for local dev).
BLOB_READ_WRITE_TOKEN=

# Only used the first time scripts/seed-db.js runs (admin_credentials is empty).
# Leave unset to seed the default username "dspaceadmin" / password "desgromedia".
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Set to 1 when deployed behind a reverse proxy (Vercel, Railway, Render, Nginx...)
# so Express reads the real client IP from X-Forwarded-For for rate limiting.
TRUST_PROXY=

PORT=3000
